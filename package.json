{
  "name": "yttv-desktop",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Local Chrome desktop client over authorized YouTube TV playback",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docs:check": "python3 scripts/check_docs.py",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts packages/ui/src/*.test.ts",
    "preview": "node scripts/preview.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run docs:check"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
