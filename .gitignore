# Keep concise run notes in Git; retain all other run artifacts locally.
# Includes copied bundles, rollback builds, images, JSON dumps, patches,
# logs and prior-document snapshots. Do not ignore source/test fixtures.
/docs/evidence/runs/**/*
!/docs/evidence/runs/**/
!/docs/evidence/runs/**/*.md
/docs/evidence/runs/**/scratch/
/docs/local-verification.json
